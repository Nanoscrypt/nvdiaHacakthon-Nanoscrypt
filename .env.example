# LLM API Keys (depending on the provider you use with LiteLLM)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# LiteLLM / LLM Provider settings
# LITELLM_LOGGING=INFO

# Nanoscrypt Setting Overrides (env variables override nanoscrypt.toml)
# NANOSCRYPT_LLM__MODEL=ollama/qwen2.5-coder
# NANOSCRYPT_LLM__TEMPERATURE=0.2
# NANOSCRYPT_LLM__MAX_TOKENS=131072
# NANOSCRYPT_RUNTIME__WORKSPACE_ROOT=./workspaces
# NANOSCRYPT_REGISTRY__DATABASE_URL=sqlite+aiosqlite:///./registry/tools.db
# NANOSCRYPT_REGISTRY__TOOLS_DIR=./generated_tools

# Nebius Token Factory (use a model ID enabled for your project)
# Keep the real key in your local .env; never commit it.
NEBIUS_API_KEY=replace-with-your-token-factory-key
NANOSCRYPT_LLM__MODEL=nebius/<model-id-from-your-token-factory-catalog>
# Optional override; inferred from NEBIUS_API_KEY for nebius/ models otherwise.
# NANOSCRYPT_LLM__API_BASE=https://api.tokenfactory.nebius.com/v1

# Required only after Nebius Sandboxes beta access is enabled
NEBIUS_PROJECT_ID=replace-with-your-nebius-project-id
# Opt into remote sandbox execution; default remains local.
# NANOSCRYPT_RUNTIME__EXECUTION_BACKEND=nebius_sandbox
